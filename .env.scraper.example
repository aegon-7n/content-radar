# Scraper secrets for cron jobs (sourced by scripts/setup-cron.sh).
# Copy to .env.scraper on the production VPS and fill in real values.
# NEVER commit .env.scraper — it is gitignored.

DATABASE_URL=postgresql://contentradar:CHANGE_ME@localhost:5432/content_radar
TIKAPI_KEY=
YOUTUBE_API_KEY=
HIKERAPI_KEY=
APIFY_TOKEN=
SOCKS_PROXY=socks5://127.0.0.1:1080

# Optional — Telegram alerts on scraper/audit failures.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
