# Copy to .env.local and fill in real values. Never commit .env.local.

# ── Database ─────────────────────────────────────────────────────────────
# Local dev: postgres on macOS via Homebrew or Docker.
# Production: PostgreSQL on the VPS where the scraper runs.
DATABASE_URL=postgresql://postgres:password@localhost:5432/content_radar

# ── Auth (NextAuth) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local dev: http://localhost:3000
# Production:  https://app.contentradar.app  (must match the app subdomain, NOT the landing domain)
NEXTAUTH_URL=http://localhost:3000

# Credentials for the grandfathered legacy tenant (tenant_id = 00000000-...-0001).
# New tenants are created via POST /api/auth/register.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Internal API tokens ──────────────────────────────────────────────────
# Bearer token for /api/scrape (lets the cron / external trigger run scraper).
SCRAPE_SECRET=change-me-in-production

# Bearer token for /api/auth/register (creates a new tenant + owner user).
# Generate with: openssl rand -hex 32
REGISTER_SECRET=change-me-in-production

# ── Scraper providers ────────────────────────────────────────────────────
# YouTube Data API v3 — https://console.cloud.google.com (free, 10K units/day).
YOUTUBE_API_KEY=

# TikAPI.io — https://tikapi.io (paid, ~$99/mo for 50K req).
TIKAPI_KEY=

# HikerAPI — https://hikerapi.com (paid, ~$0.0006-0.003/req for Instagram).
HIKERAPI_KEY=

# Apify — https://apify.com (paid, ~$0.01/req for Likee actor).
APIFY_TOKEN=

# SOCKS5 proxy used by the TikTok scraper to bypass ru_cross_border_block.
# In prod: SSH tunnel to an EU VPS. Leave empty when running outside RU.
SOCKS_PROXY=

# ── Telegram alerts (optional) ───────────────────────────────────────────
# Already used by scraper for alerts; now also used for waitlist notifications.
# Get a bot token from @BotFather, chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ── Waitlist & email ─────────────────────────────────────────────────────
# Shared secret between the landing (content-radar-landing on Vercel) and
# this app. Landing sends it in Authorization: Bearer <secret>.
# Generate with: openssl rand -hex 32
WAITLIST_INGEST_SECRET=

# Resend API key for sending confirmation emails to new waitlist signups.
# Sign up at https://resend.com and verify the noreply@contentradar.app domain.
RESEND_API_KEY=

# From-address for Resend emails. Must match a verified Resend domain.
RESEND_FROM_EMAIL="ContentRadar <noreply@contentradar.app>"

# ── Billing (ЮKassa) ─────────────────────────────────────────────────────
# Shop credentials from ЮKassa dashboard (https://yookassa.ru).
# Test mode keys start with "test_"; live keys don't.
YOOKASSA_SHOP_ID=
YOOKASSA_API_KEY=

# ── Scraper tuning (optional, has defaults) ──────────────────────────────
# Days after publish to keep scraping (older videos are skipped).
SCRAPE_HORIZON_DAYS=30
# Adaptive cadence in run_daily.py: videos newer than FRESH_DAYS are scraped
# every night; older ones are scraped at most once per (STALE_GAP_DAYS + 1)
# days. With defaults below: ≤14 days every day, older every 3 days.
FRESH_DAYS=14
STALE_GAP_DAYS=2
# Sleep between requests to a single platform.
SCRAPER_DELAY=2.0
# Retries with exponential backoff per video.
SCRAPER_MAX_RETRIES=3

# ── AI pattern analysis (scripts/analyze_patterns.py) ───────────────────────
# Google AI Studio key — https://aistudio.google.com/app/apikey
# Used by weekly cron to analyze top-N videos per tenant via Gemini 2.5 Flash.
# Budget ≤ $0.15/run (30 videos × ~10s = ~$0.06 typical).
GEMINI_API_KEY=

# OpenAI key for Whisper audio transcription (used alongside Gemini analysis).
# $0.006/min; ~30 shorts × 15s = $0.045/run.
OPENAI_API_KEY=

# ── CEO admin (HTTP Basic Auth) ──────────────────────────────────────────────
# Credentials for the secret CEO waitlist page at /ceo-x7Hg9pQ2Wf/waitlist.
# Browser prompts for username/password before any page renders.
# Generate a strong password: openssl rand -base64 16
CEO_ADMIN_BASIC_USER=
CEO_ADMIN_BASIC_PASS=

# ── QA / CI smoke account ────────────────────────────────────────────────────
# Credentials for the dedicated QA Playwright smoke tenant.
# Generated by: npx tsx scripts/seed-qa-smoke-tenant.ts
# Store in GitHub Secrets for CI use (QA_SMOKE_EMAIL, QA_SMOKE_PASSWORD).
QA_SMOKE_EMAIL=qa-smoke@contentradar.app
QA_SMOKE_PASSWORD=

# ── Webhook deploy (optional — fallback when GitHub Actions is unavailable) ──
# Random secret (min 32 chars) shared between this server and GitHub webhook.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEPLOY_WEBHOOK_SECRET=
# Port for the standalone webhook server (default: 3001).
DEPLOY_WEBHOOK_PORT=3001
# Absolute path to the app on VPS (default: parent of scripts/).
DEPLOY_PATH=/root/content-radar
